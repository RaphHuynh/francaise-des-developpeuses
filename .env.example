# Base de données PostgreSQL
DATABASE_URL="postgresql://votre_user:votre_password@db:5432/votre_db"
POSTGRES_DB=votre_db
POSTGRES_USER=votre_user
POSTGRES_PASSWORD=votre_password_securise

# NextAuth.js
NEXTAUTH_URL=https://votre-domaine.com
NEXTAUTH_SECRET=votre_secret_tres_securise_de_32_caracteres_minimum

# OAuth GitHub (optionnel)
GITHUB_CLIENT_ID=votre_github_client_id
GITHUB_CLIENT_SECRET=votre_github_client_secret

# Autres variables d'environnement
NODE_ENV=production